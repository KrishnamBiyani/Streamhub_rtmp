# Copy this file to .env.development or .env.production and fill in real values.
# NODE_ENV determines which of those two files gets loaded (see src/app.js).

MONGODB_URI=

JWT_SECRET=

CLIENT_URL=

# Host:port of the RTMP ingest server (nginx-rtmp). Use rtmp://localhost:1935
# when it's reachable directly (e.g. published Docker port); use its Docker
# Compose service hostname (e.g. rtmp://rtmp-server:1935) when the backend
# runs inside the same Compose network.
RTMP_SERVER_URL=

NODE_ENV=development
